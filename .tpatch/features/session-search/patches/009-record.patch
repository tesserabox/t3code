+      ) : null}
+      <button
+        type="button"
+        className="flex size-6 items-center justify-center rounded text-muted-foreground/70 transition-colors hover:bg-accent/40 hover:text-foreground disabled:opacity-30"
+        onClick={props.onPrevious}
