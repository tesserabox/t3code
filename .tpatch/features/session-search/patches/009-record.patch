+  it("normalizes Unicode compatibility forms and case", () => {
+    const entries = [messageEntry("unicode", "assistant", "CAFÉ cafe\u0301 Ｃａｆé")];
+    expect(deriveSessionSearchMatches(entries, "café")).toHaveLength(3);
