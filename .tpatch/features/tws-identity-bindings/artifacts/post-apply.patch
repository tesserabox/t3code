+    ON tws_stack_node_bindings(
+      environment_id,
+      feature_binding_id,
+      retired_at,
+      last_seen_at DESC,
+      stack_node_binding_id ASC
+    )
+  `;
+  yield* sql`
+    CREATE INDEX IF NOT EXISTS idx_tws_stack_node_bindings_feature_seen
+    ON tws_stack_node_bindings(
+      environment_id,
+      feature_binding_id,
+      last_seen_at DESC,
+      stack_node_binding_id ASC
+    )
+  `;
+});
